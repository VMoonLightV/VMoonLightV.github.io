---
interface Props {
  lang?: "en" | "zh";
  languageHref?: string;
  isArticle?: boolean;
  statement?: { lines: string[]; lang?: string };
}
const {
  lang = "en",
  languageHref,
  isArticle = false,
  statement = { lines: ["Exploiting the Nature and Humanity."], lang: "en" },
} = Astro.props;
const isZh = lang === "zh";
const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
const switchHref = languageHref ?? (isArticle ? undefined : isZh ? currentPath.replace(/^\/zh/, "") || "/" : `/zh${currentPath === "/" ? "/" : `${currentPath}/`}`);
const items = isZh
  ? [
      ["关于", "/zh/about/"],
      ["研究", "/zh/research/"],
      ["出版与报告", "/zh/publications/"],
      ["笔记", "/zh/notes/"],
      ["Beyond", "/zh/beyond/"],
    ]
  : [
      ["About", "/about/"],
      ["Research", "/research/"],
      ["Publications & Talks", "/publications/"],
      ["Notes", "/notes/"],
      ["Beyond", "/beyond/"],
    ];
---

<header class:list={["site-header", { "home-header": statement }]}>
  <a class="site-mark" href={isZh ? "/zh/" : "/"} aria-label={isZh ? "返回封面" : "Back to cover"}>
    YL.
  </a>
  {statement && (
    <p class="header-statement" lang={statement.lang}>
      {statement.lines.join(" ")}
    </p>
  )}
  <nav aria-label={isZh ? "主要导航" : "Primary navigation"}>
    {items.map(([label, href]) => (
      <a href={href} aria-current={currentPath === href.slice(0, -1) ? "page" : currentPath.startsWith(href) ? "location" : undefined}>
        {label}
      </a>
    ))}
    {switchHref && (
      <a class="language-link" href={switchHref} aria-label={isZh ? "Read in English" : "阅读中文版"}>
        {isZh ? "EN" : "中文"}
      </a>
    )}
  </nav>
</header>
<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    isolation: isolate;
    border-bottom: 1px solid var(--color-rule);
    display: flex;
    justify-content: space-between;
    gap: var(--space-md);
    align-items: center;
    padding: 2.25rem 0 1.75rem;
    background: var(--color-background);
    color: var(--color-accent);
  }
  .site-header::after {
    content: "";
    position: absolute;
    top: calc(100% + 1px);
    right: 0;
    left: 0;
    height: 2rem;
    background: linear-gradient(to bottom, var(--color-background), transparent);
    pointer-events: none;
  }
  .site-mark {
    font-family: var(--font-body-en);
    font-size: 3.3rem;
    line-height: 1;
    letter-spacing: -0.075em;
    text-decoration: none;
    white-space: nowrap;
  }
  .home-header {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    gap: 1rem 1.5rem;
  }
  .header-statement {
    font-family: "Monotype Corsiva", "Apple Chancery", "Segoe Script", cursive;
    font-style: italic;
    font-size: 1.4rem;
    line-height: 1.4;
    letter-spacing: -0.025em;
  }
  .home-header nav {
    column-gap: 1.5rem;
  }
  nav {
    font-family: var(--font-heading);
    font-size: 1.025rem;
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    column-gap: clamp(1.2rem, 2.5vw, 2.25rem);
    row-gap: 0.4rem;
  }
  nav a {
    text-decoration: none;
    padding: 0.65rem 0;
    border-bottom: 1px solid transparent;
  }
  nav a[aria-current],
  nav a:hover {
    border-bottom-color: currentColor;
  }
  .language-link {
    border-left: 1px solid var(--color-rule);
    padding-left: 1.5rem;
    font: 0.75rem/1.7 var(--font-ui);
    align-self: center;
  }
  @media (max-width: 1199px) {
    .home-header {
      grid-template-columns: auto minmax(0, 1fr);
    }
    .home-header nav {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 740px) {
    .site-header.home-header {
      display: grid;
      column-gap: 1.25rem;
    }
    .home-header nav {
      margin-top: 0;
    }
    .site-header {
      display: block;
      padding: 1.5rem 0 1rem;
    }
    .site-mark {
      font-size: 2.75rem;
    }
    nav {
      justify-content: flex-start;
      margin-top: var(--space-sm);
      column-gap: 1.15rem;
      row-gap: 0;
      font-size: 0.95rem;
    }
    .language-link {
      padding-left: 1rem;
    }
  }
</style>
