---
interface Props {
  lang?: "en" | "zh";
}
const { lang = "en" } = Astro.props;
---

<footer class="site-footer">
  <a href={lang === "zh" ? "/zh/" : "/"}>
    Yuyang Lou <span aria-hidden="true">↗</span>
  </a>
  <p>{lang === "zh" ? "基于 Astro 构建。" : "Powered by Astro."}</p>
  <a href="#main-content">{lang === "zh" ? "返回页首 ↑" : "Back to top ↑"}</a>
</footer>
<style>
  .site-footer {
    border-top: 1px solid var(--color-rule);
    color: var(--color-muted);
    font-family: var(--font-ui);
    font-size: 0.72rem;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1rem;
    padding: var(--space-md) 0;
  }
  a {
    text-decoration: none;
  }
</style>
