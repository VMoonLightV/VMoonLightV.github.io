---
interface Props {
  lang?: "en" | "zh";
}
const { lang = "en" } = Astro.props;
---

<footer class="site-footer">
  <p>{lang === "zh" ? "基于 Astro 构建。" : "Powered by Astro."}</p>
</footer>
<style>
  .site-footer {
    border-top: 1px solid var(--color-rule);
    color: var(--color-muted);
    font-family: var(--font-ui);
    font-size: 0.72rem;
    text-align: center;
    padding: 2rem 0 2.5rem;
  }
</style>
