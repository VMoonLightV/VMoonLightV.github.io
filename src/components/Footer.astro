---
interface Props {
  lang?: "en" | "zh";
}
const { lang = "en" } = Astro.props;
---

<footer class="site-footer">
  <a href={lang === "zh" ? "/zh/" : "/"}>
    Yuyang Lou <span aria-hidden="true">↗</span>
  </a>
  <p>{lang === "zh" ? "基于 Astro 构建。" : "Powered by Astro."}</p>
  <a href="#top">{lang === "zh" ? "返回页首 ↑" : "Back to top ↑"}</a>
</footer>
<style>
  .site-footer {
    border-top: 1px solid var(--color-rule);
    color: var(--color-muted);
    font-family: var(--font-ui);
    font-size: 0.72rem;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1rem;
    padding: 2rem 0 2.5rem;
  }
  a {
    text-decoration: none;
    color: var(--color-accent);
  }
  a:first-child {
    font: 1.15rem var(--font-body-en);
  }
  @media (max-width: 480px) {
    .site-footer {
      display: grid;
      grid-template-columns: 1fr auto;
      align-items: center;
    }
    .site-footer p {
      grid-column: 1;
      grid-row: 2;
    }
    .site-footer a:last-child {
      grid-column: 2;
      grid-row: 1 / 3;
    }
  }
</style>
