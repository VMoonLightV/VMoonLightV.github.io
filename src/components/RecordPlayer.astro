---
import { readdirSync } from "node:fs";
import { join } from "node:path";

interface Props {
  lang?: "en" | "zh";
}
const { lang = "en" } = Astro.props;
const isZh = lang === "zh";
const tracks = readdirSync(join(process.cwd(), "public/music"))
  .filter((name) => /\.(mp3|m4a|ogg|wav|aac|flac)$/i.test(name))
  .sort()
  .map((name) => ({ src: `/music/${encodeURIComponent(name)}` }));
---

<div class="record-player" data-tracks={JSON.stringify(tracks)} data-lang={lang}>
  <button
    class="record-toggle"
    type="button"
    aria-label={isZh ? "播放音乐；右键调节音量或切换下一首" : "Play music; right-click for volume or next track"}
    aria-pressed="false"
    aria-controls="beyond-volume"
    aria-expanded="false"
    disabled={tracks.length === 0}
  >
    <svg viewBox="0 0 64 52" fill="none" aria-hidden="true">
      <g class="turntable">
        <rect x="3" y="7" width="58" height="39" rx="6" fill="currentColor" />
        <path d="M9 46v3m46-3v3" stroke="currentColor" stroke-width="3" stroke-linecap="round" />
        <g class="vinyl">
          <circle cx="26" cy="26" r="16" fill="var(--color-paper)" />
          <circle cx="26" cy="26" r="13" fill="currentColor" />
          <circle cx="26" cy="26" r="10" stroke="var(--color-paper)" stroke-opacity=".3" />
          <circle cx="26" cy="26" r="7.5" stroke="var(--color-paper)" stroke-opacity=".3" />
          <path d="M15 21a12 12 0 0 1 6-6m10 22a12 12 0 0 0 6-6" stroke="var(--color-paper)" stroke-opacity=".65" stroke-linecap="round" />
          <circle cx="26" cy="26" r="4.5" fill="#c6a568" />
          <circle cx="26" cy="26" r="1.2" fill="currentColor" />
        </g>
        <circle cx="51" cy="15" r="3" fill="#c6a568" />
        <g class="tonearm">
          <path d="M51 15v12l-9 9" stroke="var(--color-paper)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
          <path d="m40 36 3 3" stroke="#c6a568" stroke-width="3" stroke-linecap="round" />
        </g>
        <circle cx="53" cy="39" r="1.5" fill="var(--color-paper)" />
      </g>
    </svg>
  </button>
  <div class="volume-panel" id="beyond-volume" hidden>
    <label for="beyond-volume-slider" title={isZh ? "音量" : "Volume"}>
      <svg class="control-icon" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M3 9h4l5-4v14l-5-4H3Z" fill="currentColor" />
        <path d="M15 8c2 2 2 6 0 8m3-11c4 4 4 10 0 14" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" />
      </svg>
    </label>
    <input id="beyond-volume-slider" type="range" min="0" max="1" step="0.01" value="0.5" aria-label={isZh ? "音量" : "Volume"} />
    <button class="next-track" type="button" aria-label={isZh ? "下一首" : "Next track"} title={isZh ? "下一首" : "Next track"} disabled={tracks.length < 2}>
      <svg class="control-icon" viewBox="0 0 24 24" aria-hidden="true">
        <polygon points="7,4 20,12 7,20" fill="currentColor" />
      </svg>
    </button>
  </div>
  <audio preload="none"></audio>
</div>

<style>
  .record-player {
    position: relative;
    display: inline-block;
    vertical-align: middle;
    margin-inline-start: 0.65rem;
    color: var(--color-accent);
    font: 0.75rem/1.4 var(--font-ui);
    letter-spacing: normal;
  }
  .record-toggle {
    display: grid;
    place-items: center;
    width: 48px;
    height: 44px;
    padding: 2px;
    border: 0;
    border-radius: 6px;
    background: transparent;
    color: inherit;
    cursor: pointer;
    touch-action: manipulation;
  }
  .record-toggle:hover { background: var(--color-surface); }
  .record-toggle:focus-visible { outline: 2px solid currentColor; outline-offset: 3px; }
  .record-toggle:disabled { opacity: 0.4; cursor: default; }
  .record-toggle svg { width: 44px; height: 36px; overflow: visible; }
  .control-icon { display: block; width: 18px; height: 18px; }
  .vinyl {
    transform-origin: 26px 26px;
    animation: record-spin 3s linear infinite paused;
  }
  .turntable {
    transform-origin: 32px 46px;
    animation: turntable-groove 0.8s ease-in-out infinite paused;
  }
  .record-player.is-playing .vinyl,
  .record-player.is-playing .turntable { animation-play-state: running; }
  .tonearm {
    transform-origin: 51px 15px;
    transform: rotate(0deg);
    transition: transform 0.55s ease-in-out;
  }
  .record-player.is-playing .tonearm { transform: rotate(20deg); }
  .volume-panel {
    position: absolute;
    top: calc(100% + 10px);
    right: 0;
    z-index: 1;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    width: 216px;
    padding: 0.8rem;
    border: 1px solid var(--color-rule);
    border-radius: 8px;
    background: var(--color-paper);
    box-shadow: 0 5px 18px rgb(0 53 107 / 10%);
    font-style: normal;
  }
  .volume-panel[hidden] { display: none; }
  .next-track {
    display: flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 28px;
    width: 28px;
    height: 28px;
    padding: 0;
    border: 1px solid var(--color-rule);
    border-radius: 50%;
    background: transparent;
    color: inherit;
    font: inherit;
    cursor: pointer;
  }
  .next-track .control-icon { width: 16px; height: 16px; }
  .next-track:hover { background: var(--color-surface); }
  .next-track:focus-visible { outline: 2px solid currentColor; outline-offset: 2px; }
  .next-track:disabled { opacity: 0.4; cursor: default; }
  input { width: 100%; min-width: 0; accent-color: var(--color-accent); cursor: pointer; }
  label { flex: 0 0 auto; }
  @keyframes record-spin { to { transform: rotate(360deg); } }
  @keyframes turntable-groove {
    0%, 50%, 100% { transform: translateY(0) rotate(0); }
    25% { transform: translateY(-0.7px) rotate(-1deg); }
    75% { transform: translateY(-0.4px) rotate(1deg); }
  }
  @media (prefers-reduced-motion: reduce) {
    .vinyl, .turntable { animation: none; }
    .tonearm { transition: none; }
    .record-player.is-playing .record-toggle { background: var(--color-surface); }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>(".record-player").forEach((player) => {
    const tracks: { src: string }[] = JSON.parse(player.dataset.tracks ?? "[]");
    const button = player.querySelector<HTMLButtonElement>(".record-toggle")!;
    const audio = player.querySelector<HTMLAudioElement>("audio")!;
    const panel = player.querySelector<HTMLElement>(".volume-panel")!;
    const slider = player.querySelector<HTMLInputElement>("input")!;
    const nextButton = player.querySelector<HTMLButtonElement>(".next-track")!;
    const isZh = player.dataset.lang === "zh";
    let trackIndex = 0;
    let pending = false;

    const updateState = () => {
      const playing = !audio.paused && !audio.ended;
      player.classList.toggle("is-playing", playing);
      button.setAttribute("aria-pressed", String(playing));
      button.setAttribute("aria-label", isZh
        ? `${playing ? "暂停" : "播放"}音乐；右键调节音量或切换下一首`
        : `${playing ? "Pause" : "Play"} music; right-click for volume or next track`);
    };
    const setVolume = (value: number) => {
      audio.volume = value;
      slider.value = String(value);
    };
    setVolume(0.5);
    try {
      const saved = localStorage.getItem("beyond-music-volume");
      const value = saved === null ? NaN : Number(saved);
      if (Number.isFinite(value) && value >= 0 && value <= 1) setVolume(value);
    } catch { /* Playback also works when browser storage is unavailable. */ }

    const play = async () => {
      if (pending || !tracks.length) return;
      pending = true;
      nextButton.disabled = true;
      if (!audio.getAttribute("src")) audio.src = tracks[trackIndex].src;
      try {
        await audio.play();
      } catch {
        // Failed playback stays paused so the next click can retry.
      } finally {
        pending = false;
        nextButton.disabled = tracks.length < 2;
        updateState();
      }
    };
    button.addEventListener("click", () => {
      if (audio.paused) void play();
      else audio.pause();
    });
    audio.addEventListener("playing", updateState);
    audio.addEventListener("pause", updateState);
    audio.addEventListener("error", () => {
      audio.pause();
      updateState();
    });
    const advanceTrack = (resume: boolean) => {
      if (pending || !tracks.length) return;
      trackIndex = (trackIndex + 1) % tracks.length;
      audio.src = tracks[trackIndex].src;
      updateState();
      if (resume) void play();
    };
    nextButton.addEventListener("click", () => advanceTrack(!audio.paused));
    audio.addEventListener("ended", () => advanceTrack(true));

    const showVolume = (show: boolean) => {
      panel.hidden = !show;
      button.setAttribute("aria-expanded", String(show));
      if (show) slider.focus();
    };
    button.addEventListener("contextmenu", (event) => {
      event.preventDefault();
      showVolume(Boolean(panel.hidden));
    });
    button.addEventListener("keydown", (event) => {
      if (event.key === "F10" && event.shiftKey) {
        event.preventDefault();
        showVolume(Boolean(panel.hidden));
      }
    });
    slider.addEventListener("input", () => {
      setVolume(Number(slider.value));
      try { localStorage.setItem("beyond-music-volume", slider.value); } catch { /* Optional preference. */ }
    });
    document.addEventListener("pointerdown", (event) => {
      if (event.target instanceof Node && !player.contains(event.target)) showVolume(false);
    });
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && !panel.hidden) {
        showVolume(false);
        button.focus();
      }
    });
  });
</script>
