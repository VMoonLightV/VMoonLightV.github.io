---
import type { MarkdownHeading } from "astro";

interface Props {
  headings: MarkdownHeading[];
  lang?: "en" | "zh";
}

const { headings, lang = "en" } = Astro.props;
const title = lang === "zh" ? "目录" : "Contents";
const minDepth = Math.min(...headings.map((heading) => heading.depth));
---

<nav class="article-contents" aria-label={title}>
  <h2>{title}</h2>
  <ul>
    {headings.map((heading) => (
      <li style={`--heading-indent: ${heading.depth - minDepth}`}>
        <a href={`#${heading.slug}`}>{heading.text}</a>
      </li>
    ))}
  </ul>
</nav>

<style>
  .article-contents {
    min-width: 0;
    border-top: 1px solid var(--color-rule);
    padding-top: 1rem;
    color: var(--color-muted);
    font: 0.85rem/1.6 var(--font-ui);
  }

  h2 {
    font: 0.7rem/1.5 var(--font-ui);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    margin-bottom: 1rem;
  }

  ul {
    list-style: none;
    padding: 0;
  }

  li {
    padding-left: calc(var(--heading-indent) * 0.75rem);
  }

  a {
    display: block;
    padding: 0.35rem 0;
    text-decoration: none;
  }

  a:hover,
  a:focus-visible {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  @media (min-width: 1200px) {
    .article-contents {
      position: sticky;
      top: 10rem;
      align-self: start;
      max-height: calc(100dvh - 12rem);
      overflow-y: auto;
      margin-top: 1rem;
    }
  }
</style>
