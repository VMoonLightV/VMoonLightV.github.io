---
import Statement from "./Statement.astro";
interface TextItem {
  text: string;
  lang?: string;
}
interface Profile {
  label: string;
  href?: string;
}
interface Props {
  content: {
    name: {
      first: string;
      last: string;
    };
    image: {
      src: string;
      alt: string;
      caption: string;
    };
    statement: {
      label: string;
      lines: string[];
      lang?: string;
    };
    personalInformation: TextItem[];
    contact: {
      label: string;
      email: string;
      profiles: Profile[];
    };
    introduction: {
      eyebrow: string;
      title: string;
      templateLabel: string;
      paragraphs: string[];
      aboutLabel: string;
      aboutHref: string;
    };
  };
}
const { content } = Astro.props;
---

<section class="cover" aria-labelledby="cover-title">
  <div class="cover-grid">
    <div class="cover-identity">
      <h1 id="cover-title">
        {content.name.first} <em>{content.name.last}</em>
      </h1>
    </div>
    <figure class="cover-image">
      <img
        src={content.image.src}
        alt={content.image.alt}
        width="876"
        height="876"
        fetchpriority="high"
      />
      <figcaption>{content.image.caption}</figcaption>
    </figure>
    <div class="cover-copy">
      <p class="eyebrow">{content.statement.label}</p>
      <div class="cover-statement" lang={content.statement.lang}>
        <Statement>
          {content.statement.lines.map((line, index) => (
            <>
              {index > 0 && <br class="desktop-break" />}
              {line}
            </>
          ))}
        </Statement>
      </div>
      <ul class="personal-information">
        {content.personalInformation.map((item) => (
          <li lang={item.lang}>{item.text}</li>
        ))}
      </ul>
    </div>
  </div>
  <div class="contact-block">
    <div class="contact-heading">
      <p class="eyebrow">{content.contact.label}</p>
    </div>
    <div class="contact-details">
      <a class="email" href={`mailto:${content.contact.email}`}>
        {content.contact.email} <span aria-hidden="true">↗</span>
      </a>
      <ul class="profile-links">
        {content.contact.profiles.map((profile) => (
          <li class:list={{ "cv-placeholder": !profile.href }}>
            {profile.href ? (
              <a href={profile.href}>
                {profile.label} <span aria-hidden="true">↗</span>
              </a>
            ) : (
              profile.label
            )}
          </li>
        ))}
      </ul>
    </div>
  </div>
  <section class="cover-introduction" aria-labelledby="introduction-title">
    <div>
      <p class="eyebrow">{content.introduction.eyebrow}</p>
      <h2 id="introduction-title">{content.introduction.title}</h2>
    </div>
    <div>
      <p class="template-label">{content.introduction.templateLabel}</p>
      {content.introduction.paragraphs.map((paragraph, index) => (
        <p class={index === 0 ? "intro-text" : "template-copy"}>{paragraph}</p>
      ))}
      <a class="about-link" href={content.introduction.aboutHref}>
        {content.introduction.aboutLabel} <span aria-hidden="true">↗</span>
      </a>
    </div>
  </section>
</section>
<style>
  h1 {
    font-size: clamp(3.75rem, 7.1vw, 6.5rem);
    line-height: 1.08;
    letter-spacing: -0.055em;
    margin: 0;
    font-family: var(--font-body-en);
    color: var(--color-accent);
  }
  h1 em {
    font-weight: normal;
  }
  .cover-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(0, 0.9fr);
    grid-template-rows: auto 1fr;
    column-gap: clamp(3rem, 7vw, 7rem);
    padding: 1.25rem 0 3.5rem;
  }
  .cover-identity {
    grid-column: 1;
    grid-row: 1;
    padding-top: 1rem;
  }
  .cover-image {
    grid-column: 2;
    grid-row: 1 / 3;
    align-self: center;
    padding: 1.25rem 1.25rem 0;
    background: #fff;
    border: 1px solid var(--color-rule);
    position: relative;
  }
  .cover-image::before {
    content: "";
    position: absolute;
    top: -1rem;
    right: -1rem;
    width: 38%;
    height: 34%;
    border-top: 1px solid var(--color-accent);
    border-right: 1px solid var(--color-accent);
    pointer-events: none;
  }
  .cover-image img {
    width: 100%;
    height: auto;
  }
  figcaption {
    padding: 1rem 0;
    color: var(--color-muted);
    font-family: var(--font-ui);
    font-size: 0.68rem;
    letter-spacing: 0.06em;
  }
  .cover-copy {
    grid-column: 1;
    grid-row: 2;
    padding-top: 2.3rem;
  }
  .cover-copy > .eyebrow::before {
    content: "";
    display: inline-block;
    width: 2rem;
    border-top: 1px solid var(--color-accent);
    vertical-align: middle;
    margin-right: 0.8rem;
  }
  .cover-statement {
    font-family: var(--font-body-en);
  }
  .cover-statement :global(.statement) {
    font-size: clamp(1.9rem, 3vw, 2.65rem);
    letter-spacing: -0.03em;
    line-height: 1.3;
    margin: 1.2rem 0 1.8rem;
    color: var(--color-accent);
    max-width: 22ch;
  }
  .personal-information {
    list-style: none;
    padding: 0;
    font: 0.9rem/1.8 var(--font-ui);
    color: var(--color-muted);
    max-width: 44ch;
  }
  .contact-block {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
    gap: 2rem;
    padding: 2rem 2.5rem;
    background: var(--color-accent);
    color: var(--color-paper);
  }
  .contact-heading {
    padding-top: 0.4rem;
  }
  .contact-heading .eyebrow {
    color: #d3e0ec;
  }
  .contact-details {
    min-width: 0;
  }
  .email {
    display: inline-block;
    font-size: clamp(1.1rem, 2vw, 1.5rem);
    text-decoration: none;
  }
  .email span {
    margin-left: 0.5rem;
    font-size: 0.9rem;
  }
  .profile-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem 1.3rem;
    margin-top: 0.85rem;
    padding: 0;
    list-style: none;
    font: 0.75rem/1.5 var(--font-ui);
  }
  .profile-links li {
    margin: 0;
  }
  .profile-links a {
    text-decoration-thickness: 1px;
    text-underline-offset: 0.3em;
  }
  .cv-placeholder {
    color: #c6d5e3;
  }
  .contact-block a:hover {
    color: #fff;
    text-decoration: underline;
  }
  .cover-introduction {
    margin-top: 4.5rem;
    padding-top: 2rem;
    border-top: 1px solid var(--color-rule);
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
    gap: 2rem;
  }
  .cover-introduction h2 {
    margin-top: 1rem;
    font-size: 2rem;
    color: var(--color-accent);
  }
  .intro-text {
    margin-top: 1rem;
    font-size: 1.25rem;
    line-height: 1.7;
  }
  .about-link {
    display: inline-block;
    margin-top: 1.5rem;
    font: 0.78rem var(--font-ui);
    text-underline-offset: 0.3em;
    color: var(--color-accent);
  }
  @media (max-width: 740px) {
    h1 {
      font-size: clamp(3.3rem, 12vw, 5rem);
    }
    .cover-grid,
    .cover-introduction,
    .contact-block {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .cover-grid {
      padding-top: 0;
      padding-bottom: 2.5rem;
    }
    .cover-identity,
    .cover-image,
    .cover-copy {
      grid-column: auto;
      grid-row: auto;
    }
    .cover-identity,
    .cover-copy {
      padding-top: 0;
    }
    .cover-image {
      max-width: 340px;
      width: calc(100% - 1rem);
      justify-self: center;
      margin-top: 0.5rem;
    }
    .cover-statement :global(.statement) {
      font-size: clamp(1.9rem, 7vw, 2.5rem);
    }
    .contact-block {
      padding: 1.75rem 1.5rem;
      gap: 1rem;
    }
    .cover-introduction {
      margin-top: 3rem;
    }
    .desktop-break {
      display: none;
    }
  }
</style>
