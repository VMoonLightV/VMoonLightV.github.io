---
interface TextItem {
  text: string;
  lang?: string;
}
interface Profile {
  label: string;
  href?: string;
}
interface Props {
  lang?: "en" | "zh";
  content: {
    name: {
      first: string;
      last: string;
    };
    image: {
      src: string;
      alt: string;
      caption: string;
    };
    statement: {
      label: string;
      lines: string[];
      lang?: string;
    };
    personalInformation: TextItem[];
    news: { date: string; text: string }[];
    contact: {
      label: string;
      email: string;
      profiles: Profile[];
    };
    introduction: {
      eyebrow: string;
      title: string;
      templateLabel: string;
      paragraphs: string[];
      aboutLabel: string;
      aboutHref: string;
    };
  };
}
const { content, lang = "en" } = Astro.props;
const isZh = lang === "zh";
---

<section class="cover" aria-labelledby="cover-title">
  <div class="cover-grid">
    <div class="cover-sidebar">
      <figure class="cover-image">
        <img src={content.image.src} alt={content.image.alt} width="876" height="876" fetchpriority="high" />
        {content.image.caption && <figcaption>{content.image.caption}</figcaption>}
      </figure>
      <ul class="personal-information">
        {content.personalInformation.map((item) => (
          <li lang={item.lang}>{item.text}</li>
        ))}
      </ul>
      <div class="contact-block">
        <p class="eyebrow">{content.contact.label}</p>
        <a class="email" href={`mailto:${content.contact.email}`}>
          {content.contact.email} <span aria-hidden="true">↗</span>
        </a>
        <ul class="profile-links">
          {content.contact.profiles.map((profile) => (
            <li class:list={{ "cv-placeholder": !profile.href }}>
              {profile.href ? (
                <a href={profile.href}>
                  {profile.label} <span aria-hidden="true">↗</span>
                </a>
              ) : (
                profile.label
              )}
            </li>
          ))}
        </ul>
      </div>
    </div>
    <div class="cover-copy">
      <h1 id="cover-title">
        {content.name.first} <em>{content.name.last}</em>
      </h1>
      <div class="cover-introduction">
        {content.introduction.paragraphs.map((paragraph) => (
          <p class="intro-text">{paragraph}</p>
        ))}
        <a class="about-link" href={content.introduction.aboutHref}>
          {content.introduction.aboutLabel} <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
  </div>
  <section class="cover-news" aria-labelledby="news-title">
    <h2 id="news-title">{isZh ? "近况 / News" : "News"}</h2>
    <ol class="news-list">
      {content.news.map((item, index) => (
        <li class="news-item">
          <span class="news-date">{item.date}</span>
          <p>{item.text}</p>
          <span class="news-number" aria-hidden="true">
            {String(index + 1).padStart(2, "0")}
          </span>
        </li>
      ))}
    </ol>
  </section>
</section>
<style>
  :global(.page-main:has(.cover)) {
    padding-top: 1.5rem;
  }
  .cover-grid {
    display: grid;
    grid-template-columns: minmax(0, 300px) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: start;
    padding: 0.5rem 0 2.5rem;
  }
  .cover-sidebar,
  .cover-copy {
    min-width: 0;
  }
  h1 {
    font-size: clamp(2.5rem, 4vw, 3.5rem);
    line-height: 1.08;
    letter-spacing: -0.055em;
    margin: 0 0 1.5rem;
    font-family: var(--font-body-en);
    color: var(--color-accent);
  }
  h1 em {
    font-weight: normal;
  }
  .cover-image {
    width: 100%;
    padding: 1rem;
    background: #fff;
    border: 1px solid var(--color-rule);
    position: relative;
  }
  .cover-image::before {
    content: "";
    position: absolute;
    top: -0.65rem;
    right: -0.65rem;
    width: 38%;
    height: 34%;
    border-top: 1px solid var(--color-accent);
    border-right: 1px solid var(--color-accent);
    pointer-events: none;
  }
  .cover-image img {
    width: 100%;
    height: auto;
  }
  figcaption {
    padding-top: 0.75rem;
    color: var(--color-muted);
    font: 0.68rem/1.5 var(--font-ui);
    letter-spacing: 0.06em;
  }
  .personal-information {
    list-style: none;
    padding: 0;
    margin: 1.25rem 0;
    font: italic 0.82rem/1.7 var(--font-ui);
    color: #000;
  }
  .contact-block {
    padding: 1.25rem;
    background: var(--color-accent);
    color: var(--color-paper);
  }
  .contact-block .eyebrow {
    color: #d3e0ec;
    margin-bottom: 0.65rem;
  }
  .email {
    font-size: 1rem;
    text-decoration: none;
  }
  .email span {
    font-size: 0.8rem;
  }
  .profile-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem 1.1rem;
    margin-top: 0.85rem;
    padding: 0;
    list-style: none;
    font: 0.75rem/1.5 var(--font-ui);
  }
  .profile-links li {
    margin: 0;
  }
  .profile-links a {
    text-decoration-thickness: 1px;
    text-underline-offset: 0.3em;
  }
  .cv-placeholder {
    color: #c6d5e3;
  }
  .contact-block a:hover {
    color: #fff;
    text-decoration: underline;
  }
  .cover-introduction {
    border-top: 1px solid var(--color-rule);
    padding: clamp(1.5rem, 3vw, 2.5rem);
    background: #fff;
  }
  .intro-text {
    font-size: 1.1rem;
    line-height: 1.75;
  }
  .about-link {
    display: inline-block;
    margin-top: 1.5rem;
    font: 0.78rem var(--font-ui);
    text-underline-offset: 0.3em;
    color: var(--color-accent);
  }
  .cover-news {
    border-top: 1px solid var(--color-rule);
    padding-top: 1.5rem;
  }
  .cover-news h2 {
    font-size: 1.65rem;
    margin-bottom: 1.25rem;
  }
  .news-list {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 0.75rem;
  }
  .news-item {
    display: grid;
    grid-template-columns: 9rem minmax(0, 1fr) auto;
    align-items: center;
    gap: 1.5rem;
    padding: 1rem 1.25rem;
    background: var(--color-surface);
    border-left: 2px solid var(--color-accent);
  }
  .news-list .news-item {
    margin: 0;
  }
  .news-date,
  .news-number {
    font: 0.7rem/1.5 var(--font-ui);
    color: var(--color-muted);
  }
  .news-item p {
    font-size: 1rem;
  }
  @media (min-width: 741px) {
    .cover-sidebar {
      padding-top: 2rem;
    }
  }
  @media (min-width: 741px) and (max-width: 1000px) {
    .cover-grid {
      grid-template-columns: minmax(0, 220px) minmax(0, 1fr);
      gap: 2rem;
    }
  }
  @media (max-width: 740px) {
    .cover-grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 2rem;
      padding-top: 0;
    }
    .cover-sidebar {
      width: min(100% - 1rem, 300px);
      justify-self: center;
    }
    h1 {
      font-size: clamp(2.5rem, 10vw, 3.3rem);
    }
    .cover-introduction {
      padding: 1.5rem;
    }
    .news-item {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 0.35rem 1rem;
    }
    .news-date {
      grid-column: 1;
    }
    .news-item p {
      grid-column: 1;
    }
    .news-number {
      grid-column: 2;
      grid-row: 1 / 3;
    }
  }
</style>
