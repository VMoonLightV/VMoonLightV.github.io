---
interface Link {
  label: string;
  href: string;
}
interface Props {
  image: string;
  title: string;
  date: string;
  description: string;
  links: Link[];
}
const { image, title, date, description, links } = Astro.props;
---

<article class="research-entry">
  <div class="research-image">
    {image ? (
      <img src={image} alt={title} loading="lazy" />
    ) : (
      <div class="image-placeholder">
        <span class="image-symbol" aria-hidden="true">
          ＋
        </span>
        <span>Project image</span>
        <span class="image-note">Image placeholder</span>
      </div>
    )}
  </div>
  <div class="research-copy">
    <header class="research-heading">
      <h2>{title}</h2>
      <p class="research-date">
        <time datetime={date}>{date.replace("-", ".")}</time>
      </p>
    </header>
    {description && <p class="research-description">{description}</p>}
    {links.length > 0 && (
      <ul>
        {links.map((link) => (
          <li>
            <a href={link.href}>{link.label} ↗</a>
          </li>
        ))}
      </ul>
    )}
  </div>
</article>
<style>
  .research-entry {
    --copy-gap: clamp(1rem, 2vw, 2rem);
    --title-inset: 1.25rem;
    --diagonal-width: clamp(14px, 1.5vw, 22px);
    --diagonal-color: #fffef9;
    border: 1px solid var(--color-rule);
    display: grid;
    grid-template-columns: minmax(0, 0.38fr) minmax(0, 0.62fr);
    column-gap: var(--copy-gap);
  }
  .research-entry + .research-entry {
    margin-top: 2rem;
  }
  .research-image {
    position: relative;
    min-height: 20rem;
    overflow: hidden;
    /* The right edge retreats to the left from top to bottom: / . */
    clip-path: polygon(0 0, 100% 0, 80% 100%, 0 100%);
    background: #eae9e3;
    align-items: center;
    display: flex;
    justify-content: center;
    color: var(--color-muted);
    font-size: 0.9rem;
  }
  .research-image img {
    position: absolute;
    inset: 0;
    height: 100%;
    width: 100%;
    object-fit: cover;
  }
  .research-image::after {
    content: "";
    position: absolute;
    inset: 0;
    background: var(--diagonal-color);
    clip-path: polygon(
      calc(100% - var(--diagonal-width)) 0,
      100% 0,
      80% 100%,
      calc(80% - var(--diagonal-width)) 100%
    );
    pointer-events: none;
  }
  .research-copy {
    min-width: 0;
    padding: 2rem 2rem 2rem 0;
  }
  .research-heading {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: start;
    gap: 1.25rem;
    margin-left: var(--title-inset);
  }
  .research-description {
    margin-top: 1.5rem;
  }
  .research-copy h2 {
    font-size: clamp(1.5rem, 3vw, 2.25rem);
  }
  .research-date {
    font: 0.8rem/1.4 var(--font-mono);
    color: var(--color-muted);
    margin: 0;
    padding-top: 0.2rem;
    white-space: nowrap;
    text-align: right;
  }
  ul {
    list-style: none;
    margin-top: var(--space-sm);
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
  }
  li {
    margin: 0;
  }
  .image-placeholder {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 100%;
    gap: 0.65rem;
    font-family: var(--font-ui);
    text-align: center;
    padding: 2rem 24% 2rem 1rem;
  }
  .image-symbol {
    font: 3rem var(--font-body-en);
  }
  .image-note {
    font-size: 0.65rem;
  }
  @media (max-width: 740px) {
    .research-entry {
      grid-template-columns: minmax(0, 1fr);
      gap: 0;
    }
    .research-copy {
      padding: 1.5rem;
    }
    .research-heading {
      margin-left: 0;
      gap: 1rem;
    }
    .research-image {
      min-height: 0;
      clip-path: none;
      border-bottom: 1px solid var(--color-rule);
    }
    .research-image img {
      position: static;
      height: auto;
      object-fit: contain;
    }
    .research-image::after {
      display: none;
    }
    .image-placeholder {
      min-height: 14rem;
      aspect-ratio: 16 / 9;
      padding: 1.5rem;
    }
  }
</style>
