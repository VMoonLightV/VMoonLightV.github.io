---
interface Link {
  label: string;
  href: string;
}
interface Props {
  image: string;
  title: string;
  date: string;
  description: string;
  links: Link[];
}
const {
  image,
  title,
  date,
  description,
  links,
} = Astro.props;
const dateLines = date.trim().split(/\r?\n/);
---

<article class="research-entry">
  <div class="research-image">
    <div class="image-frame">
      {image ? (
        <img src={image} alt={title} loading="lazy" />
      ) : (
        <div class="image-placeholder">
          <span class="image-symbol" aria-hidden="true">
            ＋
          </span>
          <span>Project image</span>
          <span class="image-note">Image placeholder</span>
        </div>
      )}
    </div>
  </div>
  <div class="research-copy">
    <header class="research-heading">
      <h2>{title}</h2>
      <p class="research-date">
        <time datetime={dateLines[0]}>
          {dateLines.map((line, index) => (
            <>
              {index > 0 && <br />}
              {line.replace(/-/g, ".")}
            </>
          ))}
        </time>
      </p>
    </header>
    {description && <p class="research-description">{description}</p>}
    {links.length > 0 && (
      <ul>
        {links.map((link) => (
          <li>
            <a href={link.href}>{link.label} ↗</a>
          </li>
        ))}
      </ul>
    )}
  </div>
</article>
<style>
  .research-entry {
    --copy-gap: clamp(1rem, 5vw, 2rem);
    --title-inset: 1.25rem;
    --diagonal-width: clamp(14px, 1.5vw, 22px);
    --diagonal-color: #f7f7f7;
    border: 1px solid var(--color-rule);
    display: grid;
    grid-template-columns: minmax(0, 0.38fr) minmax(0, 0.62fr);
    column-gap: var(--copy-gap);
  }
  .research-entry + .research-entry {
    margin-top: 2rem;
  }
  .research-image {
    position: relative;
    min-height: 20rem;
    overflow: hidden;
    color: var(--color-muted);
    font-size: 0.9rem;
  }
  .image-frame {
    position: absolute;
    inset: 0;
    overflow: hidden;
    background: var(--color-surface);
    clip-path: polygon(0 0, 100% 0, 80% 100%, 0 100%);
  }
  .research-image img {
    position: absolute;
    inset: 0 auto 0 0;
    display: block;
    height: 100%;
    width: auto;
    max-width: none;
    object-fit: contain;
    object-position: left top;
  }
  .research-image::after {
    content: "";
    position: absolute;
    inset: 0;
    background: var(--diagonal-color);
    clip-path: polygon(
      calc(100% - var(--diagonal-width)) 0,
      calc(100% + 2px) 0,
      calc(80% + 2px) 100%,
      calc(80% - var(--diagonal-width)) 100%
    );
    pointer-events: none;
    z-index: 1;
  }
  .research-copy {
    min-width: 0;
    padding: 2rem 2rem 2rem 0;
  }
  .research-heading {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: start;
    gap: 1.25rem;
    margin-left: var(--title-inset);
  }
  .research-description {
    margin-top: 1.5rem;
    font-size: 1rem;
    line-height: 1.85;
    color: var(--color-muted);
    white-space: pre-line;
  }
  .research-copy h2 {
    font-size: clamp(1.4rem, 2.7vw, 2rem);
  }
  .research-date {
    font: 0.75rem/1.4 var(--font-ui);
    color: var(--color-muted);
    margin: 0;
    padding-top: 0.2rem;
    white-space: pre-line;
    text-align: right;
  }
  ul {
    list-style: none;
    margin-top: var(--space-sm);
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
  }
  li {
    margin: 0;
  }
  .image-placeholder {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 100%;
    background: var(--color-surface);
    gap: 0.65rem;
    font-family: var(--font-ui);
    text-align: center;
    padding: 2rem 24% 2rem 1rem;
  }
  .image-symbol {
    font: 3rem var(--font-body-en);
  }
  .image-note {
    font-size: 0.65rem;
  }
  @media (max-width: 740px) {
    .research-entry {
      grid-template-columns: minmax(0, 1fr);
      gap: 0;
    }
    .research-copy {
      padding: 1.5rem;
    }
    .research-heading {
      margin-left: 0;
      gap: 1rem;
    }
    .research-image {
      min-height: 0;
      border-bottom: 1px solid var(--color-rule);
    }
    .image-frame {
      position: relative;
      inset: auto;
      overflow: visible;
      clip-path: none;
    }
    .research-image img {
      position: relative;
      height: auto;
      width: 100%;
      max-width: 100%;
      object-fit: contain;
      object-position: left top;
    }
    .research-image::after {
      display: none;
    }
    .image-placeholder {
      position: relative;
      inset: auto;
      min-height: 14rem;
      aspect-ratio: 16 / 9;
      padding: 1.5rem;
      clip-path: none;
    }
  }
</style>
