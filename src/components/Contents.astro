---
interface Item { href: string; label: string }
interface Props { items: Item[]; title?: string }
const { items, title = 'Contents' } = Astro.props;
---
{items.length > 0 && <nav class="contents" aria-label={title}><h2>{title}</h2><ul>{items.map((item) => <li><a href={item.href}>{item.label}</a></li>)}</ul></nav>}
<style>.contents { border-top: 1px solid var(--color-rule); margin-top: var(--space-lg); max-width: var(--text-width); padding-top: var(--space-sm); } h2 { font-size: 1.15rem; margin-bottom: var(--space-xs); } ul { padding-left: 1.2em; }</style>
