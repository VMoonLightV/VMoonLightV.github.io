---
interface Item {
  href: string;
  label: string;
}
interface Props {
  items: Item[];
  title?: string;
}
const { items, title = "Contents" } = Astro.props;
---

{items.length > 0 && (
  <nav class="contents" aria-label={title}>
    <>
      <h2>{title}</h2>
      <ul>
        {items.map((item, index) => (
          <li>
            <a href={item.href}>
              <span class="entry-number" aria-hidden="true">
                {String(index + 1).padStart(2, "0")}
              </span>
              <span>{item.label}</span>
              <span class="entry-arrow" aria-hidden="true">
                ↗
              </span>
            </a>
          </li>
        ))}
      </ul>
    </>
  </nav>
)}
<style>
  .contents {
    border-top: 1px solid var(--color-rule);
    margin-top: var(--space-lg);
    padding-top: var(--space-sm);
  }
  h2 {
    font-family: var(--font-ui);
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    margin-bottom: var(--space-md);
  }
  ul {
    padding: 0;
    list-style: none;
  }
  li {
    margin: 0;
    border-bottom: 1px solid var(--color-rule);
  }
  a {
    display: grid;
    grid-template-columns: 3rem minmax(0, 1fr) 1.5rem;
    gap: 1rem;
    align-items: baseline;
    padding: 1.3rem 0;
    font-size: clamp(1.25rem, 2.7vw, 1.8rem);
    text-decoration: none;
  }
  .entry-number,
  .entry-arrow {
    font: 0.7rem var(--font-ui);
    color: var(--color-muted);
  }
  a:hover > span:nth-child(2) {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }
  @media (max-width: 640px) {
    a {
      grid-template-columns: 1.5rem minmax(0, 1fr) 1rem;
      gap: 0.6rem;
    }
  }
</style>
