---
import { getCollection } from "astro:content";
import IndexLayout from "../../layouts/IndexLayout.astro";
import Contents from "../../components/Contents.astro";
import { contentUrl, directContentChildren } from "../../lib/content";
const entries = directContentChildren(await getCollection("notes", ({ data }) => !data.draft && data.lang === "en"));
const items = entries.map((entry) => ({
  href: contentUrl("notes", entry.id, "en"),
  label: entry.data.title,
}));
---

<IndexLayout title="Notes">
  <p>These notes are mostly my personal study reviews and reflections on various subjects, written in a narrative style.</p>
  <Contents items={items} />
</IndexLayout>
