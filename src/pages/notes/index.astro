---
import { getCollection } from 'astro:content';
import IndexLayout from '../../layouts/IndexLayout.astro';
import Contents from '../../components/Contents.astro';
import { contentUrl } from '../../lib/content';
const entries = (await getCollection('notes', ({ data }) => !data.draft && data.lang === 'en')).sort((a, b) => a.id.localeCompare(b.id));
const items = entries.map((entry) => ({ href: contentUrl('notes', entry.id, 'en'), label: entry.data.title }));
---
<IndexLayout title="Notes"><p>Placeholder index.</p><Contents items={items} /></IndexLayout>
