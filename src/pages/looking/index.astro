---
import { getCollection } from 'astro:content';
import IndexLayout from '../../layouts/IndexLayout.astro';
import Contents from '../../components/Contents.astro';
import { contentUrl } from '../../lib/content';
const entries = (await getCollection('looking', ({ data }) => !data.draft && data.lang === 'en')).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const items = entries.map((entry) => ({ href: contentUrl('looking', entry.id, 'en'), label: entry.data.title }));
---
<IndexLayout title="Looking"><p>Placeholder index.</p><Contents items={items} /></IndexLayout>
