---
import { getCollection } from "astro:content";
import IndexLayout from "../../layouts/IndexLayout.astro";
import ResearchEntry from "../../components/ResearchEntry.astro";
const entries = (
  await getCollection(
    "research",
    ({ data }) => !data.draft && data.lang === "en",
  )
).sort((a, b) => b.data.date.localeCompare(a.data.date));
---

<IndexLayout title="Research">
  {entries.map((entry) => (
    <ResearchEntry {...entry.data} />
  ))}
</IndexLayout>
