---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Placeholder">
  <section class="cover">
    <h1>Placeholder name</h1>
    <div class="cover-content">
      <p>Image placeholder</p>
      <ul>
        <li>Personal information placeholder</li>
        <li>Contact placeholder</li>
        <li>ORCID placeholder</li>
        <li>GitHub placeholder</li>
        <li>CV placeholder</li>
      </ul>
      <p>Short statement placeholder.</p>
    </div>
  </section>
</BaseLayout>
<style>
  .cover {
    min-height: 55vh;
    display: grid;
    align-content: space-between;
    gap: var(--space-xl);
  }
  .cover-content {
    border-top: 1px solid var(--color-rule);
    max-width: var(--text-width);
    padding-top: var(--space-sm);
  }
  ul {
    list-style: none;
    margin: var(--space-md) 0;
    padding: 0;
  }
</style>
