---
import { getCollection } from 'astro:content';
import IndexLayout from '../../../layouts/IndexLayout.astro';
import Contents from '../../../components/Contents.astro';
import { contentUrl } from '../../../lib/content';
const entries = (await getCollection('zhLooking', ({ data }) => !data.draft && data.lang === 'zh')).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const items = entries.map((entry) => ({ href: contentUrl('looking', entry.id, 'zh'), label: entry.data.title }));
---
<IndexLayout title="观看" lang="zh"><p>占位符索引。</p><Contents items={items} title="目录" /></IndexLayout>
