---
import { getCollection } from "astro:content";
import IndexLayout from "../../../layouts/IndexLayout.astro";
import ResearchEntry from "../../../components/ResearchEntry.astro";
const entries = (
  await getCollection(
    "research",
    ({ data }) => !data.draft && data.lang === "zh",
  )
).sort((a, b) => b.data.date.localeCompare(a.data.date));
---

<IndexLayout title="研究" lang="zh">
  {entries.length > 0 ? (
    entries.map((entry) => <ResearchEntry {...entry.data} />)
  ) : (
    <p>占位符内容。</p>
  )}
</IndexLayout>
