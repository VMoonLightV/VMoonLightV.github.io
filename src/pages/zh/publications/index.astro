---
import IndexLayout from "../../../layouts/IndexLayout.astro";
---

<IndexLayout title="出版与报告" lang="zh">
  <p>论文、报告与相关材料。</p>
  <section class="template-section">
    <p class="eyebrow">01 / 论文</p>
    <div>
      <p class="template-label">格式模板 · 尚未添加条目</p>
      <h2>［论文标题］</h2>
      <p class="template-copy">
        ［作者名单，按发表顺序］
        <br />
        ［期刊或会议 · 年份 · 卷号与页码］
      </p>
      <p class="template-copy">［可补充 DOI、预印本及代码链接。］</p>
    </div>
  </section>
  <section class="template-section">
    <p class="eyebrow">02 / 报告</p>
    <div>
      <p class="template-label">格式模板 · 尚未添加条目</p>
      <h2>［报告标题］</h2>
      <p class="template-copy">［活动或机构 · 地点 · 日期］</p>
      <p class="template-copy">
        ［简述主题与听众，按需添加幻灯片或录像链接。］
      </p>
    </div>
  </section>
</IndexLayout>
