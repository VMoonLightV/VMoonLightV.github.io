---
import { getCollection } from "astro:content";
import IndexLayout from "../../../layouts/IndexLayout.astro";
import Contents from "../../../components/Contents.astro";
import { contentUrl } from "../../../lib/content";
const entries = (
  await getCollection(
    "zhNotes",
    ({ data }) => !data.draft && data.lang === "zh",
  )
).sort((a, b) => a.id.localeCompare(b.id));
const items = entries.map((entry) => ({
  href: contentUrl("notes", entry.id, "zh"),
  label: entry.data.title,
}));
---

<IndexLayout title="笔记" lang="zh">
  <p>按主题整理的笔记。</p>
  <p class="template-copy">
    ［写作模板：介绍这些笔记的范围、适合从哪里开始阅读，以及哪些问题仍待补充。］
  </p>
  <Contents items={items} title="目录" />
</IndexLayout>
