---
import IndexLayout from "../../layouts/IndexLayout.astro";
---

<IndexLayout title="About">
  <p>Once upon a time...</p>
  <section class="template-section">
    <p class="eyebrow">01 / Background</p>
    <div>
      <p class="template-label">Writing template · to be replaced</p>
      <h2>A place to begin</h2>
      <p class="template-copy">
        [Introduce your current role and the path that brought you here. Choose
        one or two experiences that help a reader understand your perspective,
        rather than reproducing a full CV.]
      </p>
    </div>
  </section>
  <section class="template-section">
    <p class="eyebrow">02 / Questions</p>
    <div>
      <h2>What holds my attention</h2>
      <p class="template-copy">
        [Describe a question you keep returning to. Explain what makes it
        interesting to you, what you are learning, and which parts remain
        uncertain.]
      </p>
    </div>
  </section>
  <section class="template-section">
    <p class="eyebrow">03 / Elsewhere</p>
    <div>
      <h2>Beyond the short introduction</h2>
      <p class="template-copy">
        [Add a personal detail, a reading habit, or an experience you would like
        to share. Replace this prompt with your own words, and omit this section
        if it does not belong in your story.]
      </p>
    </div>
  </section>
</IndexLayout>
