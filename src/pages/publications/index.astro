---
import IndexLayout from "../../layouts/IndexLayout.astro";
---

<IndexLayout title="Publications & Talks">
  <p>A place for publications, presentations, and related materials.</p>
  <section class="template-section">
    <p class="eyebrow">01 / Publications</p>
    <div>
      <p class="template-label">Reference format · no entries added</p>
      <h2>[Publication title]</h2>
      <p class="template-copy">
        [Authors, in publication order]
        <br />
        [Journal or proceedings · year · volume / pages]
      </p>
      <p class="template-copy">
        [Add the DOI, preprint, and code links when available.]
      </p>
    </div>
  </section>
  <section class="template-section">
    <p class="eyebrow">02 / Talks</p>
    <div>
      <p class="template-label">Reference format · no entries added</p>
      <h2>[Talk title]</h2>
      <p class="template-copy">[Event or institution · location · date]</p>
      <p class="template-copy">
        [Add a short description of the audience and topic, followed by slides
        or a recording when available.]
      </p>
    </div>
  </section>
</IndexLayout>
