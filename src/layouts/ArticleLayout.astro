---
import BaseLayout from "./BaseLayout.astro";
interface Props {
  title: string;
  date: Date;
  description?: string;
  lang?: "en" | "zh";
  translationHref?: string;
}
const {
  title,
  date,
  description = "",
  lang = "en",
  translationHref,
} = Astro.props;
---

<BaseLayout
  title={title}
  description={description}
  lang={lang}
  isArticle
  languageHref={translationHref}
>
  <article class="prose">
    <header>
      <p class="eyebrow">{lang === "zh" ? "文稿" : "From the archive"}</p>
      <h1>{title}</h1>
      <p class="article-meta">
        <time datetime={date.toISOString().slice(0, 10)}>
          {date.toLocaleDateString(lang === "zh" ? "zh-CN" : "en-GB", {
            year: "numeric",
            month: "long",
            day: "numeric",
          })}
        </time>
      </p>
      {translationHref && (
        <p class="article-language">
          <a href={translationHref}>
            {lang === "zh" ? "Read in English" : "阅读中文版"}
          </a>
        </p>
      )}
    </header>
    <slot />
  </article>
</BaseLayout>
