---
import BaseLayout from "./BaseLayout.astro";
import ArticleContents from "../components/ArticleContents.astro";
import type { BreadcrumbItem } from "../lib/content";
import type { MarkdownHeading } from "astro";
import "katex/dist/katex.min.css";
import "../styles/math.css";
interface Props {
  title: string;
  date: Date;
  description?: string;
  lang?: "en" | "zh";
  translationHref?: string;
  headings?: MarkdownHeading[];
  isTopic?: boolean;
  breadcrumbs?: BreadcrumbItem[];
}
const { title, date, description = "", lang = "en", translationHref, headings = [], isTopic = false, breadcrumbs = [] } = Astro.props;
---

<BaseLayout title={title} description={description} lang={lang} isArticle languageHref={translationHref}>
  <div class:list={["article-layout", { "with-contents": headings.length > 0 || breadcrumbs.length > 0 }]}>
    <aside class="article-sidebar">
      {breadcrumbs.length > 0 && (
        <nav class="breadcrumbs" aria-label={lang === "zh" ? "文章路径" : "Breadcrumb"}>
          <ol>
            {breadcrumbs.map((item, index) => (
              <li class:list={{ "current-article": index === breadcrumbs.length - 1 }}>{item.href ? <a href={item.href}>{item.label}</a> : <span aria-current="page">{item.label}</span>}</li>
            ))}
          </ol>
        </nav>
      )}
      {headings.length > 0 && <ArticleContents headings={headings} lang={lang} />}
    </aside>
    <article class:list={["prose", { "topic-page": isTopic }]}>
      <header>
        <h1>{title}</h1>
        {!isTopic && (
          <p class="article-meta">
            <time datetime={date.toISOString().slice(0, 10)}>
              {date.toLocaleDateString(lang === "zh" ? "zh-CN" : "en-GB", {
                year: "numeric",
                month: "long",
                day: "numeric",
              })}
            </time>
          </p>
        )}
        {translationHref && (
          <p class="article-language">
            <a href={translationHref}>{lang === "zh" ? "Read in English" : "阅读中文版"}</a>
          </p>
        )}
      </header>
      <slot />
    </article>
  </div>
</BaseLayout>

<style>
  :global(.page-main:has(.article-layout)) {
    padding-top: 2rem;
  }
  .article-sidebar {
    min-width: 0;
    align-self: start;
  }
  .breadcrumbs {
    margin-bottom: 1.5rem;
    font: italic 0.78rem/1.7 var(--font-ui);
    color: var(--color-muted);
  }
  .breadcrumbs ol {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem 0.65rem;
    list-style: none;
    padding: 0;
  }
  .breadcrumbs li {
    display: flex;
    gap: 0.65rem;
    min-width: 0;
    margin: 0;
  }
  .breadcrumbs li + li::before {
    content: ">";
    color: var(--color-muted);
  }
  .breadcrumbs li:nth-last-child(2)::after {
    content: ">";
  }
  .breadcrumbs .current-article {
    flex-basis: 100%;
  }
  .breadcrumbs a {
    color: var(--color-accent);
    text-decoration: none;
  }
  .breadcrumbs a:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .topic-page {
    padding-top: 0;
  }

  .topic-page > header {
    position: relative;
    border-bottom: 0;
    padding-bottom: 1rem;
    margin-bottom: 1.25rem;
  }

  .topic-page > header::after {
    content: "";
    position: absolute;
    bottom: 0;
    left: 0;
    width: 3rem;
    border-bottom: 2px solid var(--color-accent);
  }

  .topic-page > header h1 {
    margin-top: 0;
    font-size: clamp(2rem, 4vw, 3rem);
  }

  .topic-page .article-meta,
  .topic-page .article-language {
    margin-top: 0.5rem;
  }

  .article-layout.with-contents {
    display: grid;
    gap: 2rem;
  }

  .article-layout > article {
    min-width: 0;
    width: 100%;
    padding-top: 0;
  }

  .with-contents :global(.prose :is(h1, h2, h3, h4, h5, h6)[id]) {
    scroll-margin-top: 10rem;
  }

  @media (min-width: 1200px) {
    .article-sidebar {
      position: sticky;
      top: 9.375rem;
      max-height: calc(100dvh - 9.375rem);
      overflow-y: auto;
    }
    .article-sidebar :global(.article-contents) {
      position: static;
      max-height: none;
      overflow: visible;
    }
    .article-layout.with-contents {
      grid-template-columns: minmax(9rem, 1fr) minmax(0, 3fr);
    }

    .with-contents > article {
      margin-inline: 0;
    }
  }

  @media (max-width: 1199px) {
    .article-layout.with-contents {
      max-width: var(--text-width);
      margin-inline: auto;
    }
  }

  @media (max-width: 740px) {
    .with-contents :global(.prose :is(h1, h2, h3, h4, h5, h6)[id]) {
      scroll-margin-top: 14rem;
    }
  }
</style>
